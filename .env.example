NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
OPENAI_API_KEY=
# optional; defaults to gpt-5.6-terra (confirm it exists for your account)
OPENAI_MODEL=
# background jobs: Vercel Cron sends this as a Bearer token; set the same value in the project env
CRON_SECRET=
# optional malware scanner for uploads (POST bytes, answers {"infected": boolean})
VIRUS_SCAN_URL=
# public origin for previews/sitemap (defaults to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=
