NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
OPENAI_API_KEY=
# optional; defaults to gpt-5.6-terra (confirm it exists for your account)
OPENAI_MODEL=
# background jobs: Vercel Cron sends this as a Bearer token; set the same value in the project env
CRON_SECRET=
# optional malware scanner for uploads (POST bytes, answers {"infected": boolean})
VIRUS_SCAN_URL=
# public origin for previews/sitemap (defaults to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=
# "fastapi" sends the chat to the Python backend (API_URL) through /api/v1/chat; empty keeps the Next.js route
NEXT_PUBLIC_CHAT_API=
# email of the support channel shown in "O que posso pedir?" (#158); empty hides the link
NEXT_PUBLIC_SUPPORT_EMAIL=
# 32 bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))". Required in production.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1
ADMIN_EMAILS=
# FastAPI backend (server-only): the Next.js proxy /api/v1/* forwards here with the user token
API_URL=http://localhost:8100
